# Maintainer: dontleteuwatchyou
#
# Plume pour Arch Linux. Le moteur web est Chromium embarqué (CEF), livré
# dans /usr/lib/plume : WebKitGTK n'avait ni un vocal fiable ni la mémoire
# de V8 (voir src-tauri/src/rt.rs).

pkgname=plume
pkgver=0.5.2
pkgrel=1
pkgdesc="Client Discord léger : discord.com/app avec Plumecord, le micro en stéréo et le push-to-talk global"
arch=(x86_64)
url="https://github.com/dontleteuwatchyou/plume"
license=(GPL-3.0-or-later)
depends=(
  gtk3
  # Le CEF du dépôt, compilé avec `rtc_use_h264` (OpenH264) : sans lui, pas de
  # H.264 dans WebRTC et les streams Discord n'affichent jamais rien. Le CEF
  # officiel livré par cef-dll-sys ne l'a pas. Version exacte : la crate
  # cef-dll-sys est épinglée sur cette série.
  'cef=154.0.34'
  libayatana-appindicator
  # Ce que libcef demande au système (mêmes dépendances que le paquet cef).
  alsa-lib
  at-spi2-core
  dbus
  libdrm
  libpulse
  libxcomposite
  libxdamage
  libxkbcommon
  libxrandr
  mesa
  nss
  pango
  systemd-libs
  # Partage d'écran : Chromium passe par le portail du bureau (PipeWire).
  pipewire
  xdg-desktop-portal
  xdg-utils
)
makedepends=(cargo git)
optdepends=(
  'xdg-desktop-portal-hyprland: partage d écran sous Hyprland'
  'xdg-desktop-portal-gnome: partage d écran sous GNOME'
  'xdg-desktop-portal-kde: partage d écran sous KDE'
  'xdg-desktop-portal-wlr: partage d écran sous Sway et wlroots'
)
# Plume 0.4 tournait sur ce WebKitGTK maison, plus utilisé.
replaces=(plume-webkit)
install=plume.install
# Le LTO de makepkg compile le C de `ring` en bitcode que l'édition de liens de
# Rust ne lit pas (symboles introuvables) ; Rust optimise déjà tout seul.
# libcef est strippé à la main (238 Mo au lieu de 1,2 Go) ; `strip` de makepkg
# ne doit pas repasser sur les autres binaires de Chromium.
options=(!lto !strip)
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd plume/src-tauri
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"

  # cef-dll-sys veut une distribution CEF à lui ; sans elle il retélécharge le
  # CEF officiel, qui n'a pas OpenH264. On lui en fabrique une à partir du
  # paquet `cef`, avec l'`archive.json` qu'il vérifie au démarrage.
  local dist="$srcdir/cef"
  rm -rf "$dist"; install -dm755 "$dist"
  local f
  for f in /usr/lib/cef/*; do ln -sfn "$f" "$dist/$(basename "$f")"; done
  ln -sfn /usr/include/cef/include "$dist/include"
  ln -sfn /usr/src/cef/libcef_dll "$dist/libcef_dll"
  cat > "$dist/archive.json" <<JSON
{
  "type": "minimal",
  "name": "cef_binary_154.0.34+gsystem+chromium-154.0.8037.154_linux64_minimal.tar.bz2",
  "sha1": "0000000000000000000000000000000000000000"
}
JSON
}

build() {
  cd plume/src-tauri
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  # La distribution assemblée par prepare() à partir du paquet `cef`.
  export CEF_PATH="$srcdir/cef"
  # libcef et ses ressources sont à côté du binaire, dans /usr/lib/plume.
  export RUSTFLAGS="$RUSTFLAGS -C link-arg=-Wl,-rpath,\$ORIGIN"
  # `custom-protocol` : les pages de Plume (dist/) embarquées dans le binaire,
  # ce que fait `tauri build`.
  cargo build --frozen --release --features tauri/custom-protocol
}

package() {
  cd plume
  local lib="$pkgdir/usr/lib/plume"
  install -dm755 "$lib"
  strip --strip-unneeded src-tauri/target/release/plume -o "$lib/plume"
  chmod 755 "$lib/plume"
  # libcef et ses ressources viennent du paquet `cef` : des liens plutôt que
  # 273 Mo recopiés. Le binaire est lié en `rpath=$ORIGIN`, le lien suffit, et
  # CEF cherche ses ressources à côté de lui.
  local f
  for f in libcef.so libvk_swiftshader.so libvulkan.so.1 vk_swiftshader_icd.json \
           chrome_100_percent.pak chrome_200_percent.pak resources.pak \
           icudtl.dat v8_context_snapshot.bin; do
    [ -e "/usr/lib/cef/$f" ] && ln -s "/usr/lib/cef/$f" "$lib/$f"
  done
  # Seulement les langues utiles : 49 Mo de traductions de Chromium sinon.
  install -dm755 "$lib/locales"
  for f in fr en-US en-GB; do
    [ -e "/usr/lib/cef/locales/$f.pak" ] && ln -s "/usr/lib/cef/locales/$f.pak" "$lib/locales/$f.pak"
  done
  install -dm755 "$pkgdir/usr/bin"
  ln -s /usr/lib/plume/plume "$pkgdir/usr/bin/plume"
  install -Dm644 linux/plume.desktop "$pkgdir/usr/share/applications/plume.desktop"
  install -Dm644 assets/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/plume.svg"
  install -Dm644 src-tauri/icons/128x128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/plume.png"
  install -Dm644 src-tauri/icons/32x32.png "$pkgdir/usr/share/icons/hicolor/32x32/apps/plume.png"
}

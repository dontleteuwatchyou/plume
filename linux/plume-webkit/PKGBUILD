# Maintainer: dontleteuwatchyou
# D'après le paquet webkit2gtk-4.1 d'Arch (Jan Alexander Steffens, Eric Bélanger).
#
# WebKitGTK compilé avec WebRTC, ce qu'aucune distribution ne fait : sans lui,
# Discord n'a ni appel, ni partage d'écran, ni micro stéréo. Installé à part
# dans /usr/lib/plume, il ne remplace pas le WebKit du système.

pkgname=plume-webkit
pkgver=2.54.2
pkgrel=1
_wkver=2.54.2
pkgdesc="WebKitGTK avec WebRTC, a prefixe prive, pour Plume"
url="https://webkitgtk.org"
arch=(x86_64)

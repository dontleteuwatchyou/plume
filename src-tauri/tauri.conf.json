{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plume",
  "version": "0.3.0",
  "identifier": "app.plume.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRkNFREU5OEMwQ0M1NDcKUldSSHhReU02ZTM4Y0pjWkVxcCtpRHVJQkdwSVNDb1lodE9zelR5T3Jxb3JDdTJMUHFXbzJJcE4K",
      "endpoints": [
        "https://github.com/dontleteuwatchyou/plume/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

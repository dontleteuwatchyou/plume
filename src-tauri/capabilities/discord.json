{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "discord",
  "description": "Les seules commandes que la page Discord peut appeler.",
  "windows": ["main"],
  "remote": {
    "urls": ["https://discord.com/*", "https://*.discord.com/*"]
  },
  "permissions": ["allow-notify", "allow-open-url", "allow-ptt-keys", "allow-win-minimize", "allow-win-toggle-maximize", "allow-win-close", "allow-open-settings", "allow-audio-config", "allow-audio-report"]
}
